# Maintainer: Adam <adam@swamp-club.com>
pkgname=lazydocker-bin
pkgver=0.25.2
pkgrel=1
pkgdesc="Simple terminal UI for both docker and docker-compose, prebuilt binary release"
arch=(x86_64)
url="https://github.com/jesseduffield/lazydocker"
license=(MIT)
optdepends=('docker: manage Docker containers'
            'docker-compose: manage docker-compose services')
provides=(lazydocker=$pkgver)
conflicts=(lazydocker)
options=(!strip !debug)
source_x86_64=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/lazydocker_${pkgver}_Linux_x86_64.tar.gz")
sha256sums_x86_64=('0d9dbfc26068b218e7ed84b104748cadc6e3cf733c0afd35465306fb39b9523c')

# check(): omitted — upstream ships no test suite with the prebuilt binary release.

package() {
  install -Dm755 "$srcdir"/lazydocker "$pkgdir"/usr/bin/lazydocker
  install -Dm644 "$srcdir"/LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
  install -Dm644 "$srcdir"/README.md "$pkgdir"/usr/share/doc/$pkgname/README.md
}
