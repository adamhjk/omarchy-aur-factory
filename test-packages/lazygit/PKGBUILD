# Maintainer: Omarchy AUR Factory <adam@swamp-club.com>
pkgname=lazygit
pkgver=0.64.1
pkgrel=1
pkgdesc="Simple terminal ui for git commands"
arch=(x86_64)
url="https://github.com/jesseduffield/lazygit"
license=(MIT)
depends=(glibc)
makedepends=(go)
source=("$pkgname-$pkgver.tar.gz::https://github.com/jesseduffield/lazygit/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b1df6ee72f17efc0ef95fc20a64821cd9eda3935b81cb98b1719c8266163bd07')

build() {
  cd "$pkgname-$pkgver"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOPATH="${srcdir}"
  export GOFLAGS="-buildmode=pie -trimpath -mod=vendor -modcacherw"
  go build -ldflags "-linkmode=external -X main.version=$pkgver -X main.buildSource=archlinux" \
    -o lazygit .
}

check() {
  cd "$pkgname-$pkgver"
  export GOPATH="${srcdir}"
  export GOFLAGS="-mod=vendor -modcacherw"

  # The test suite (notably pkg/integration/components, which tests the
  # integration-test framework itself) locates the project root by walking
  # up from the working directory looking for a ".git" entry
  # (vendor/github.com/jesseduffield/lazycore/pkg/utils/utils.go:
  # GetLazyRootDirectory). Release tarballs, unlike a git checkout, don't
  # contain a .git directory, so that lookup hits "/" and calls
  # log.Fatal("must run in lazy project folder or child folder"), aborting
  # the whole test binary. A real repository isn't required: every caller
  # only uses the returned path to reach files that do ship in the tarball
  # (e.g. test/global_git_config), so a placeholder .git directory is
  # enough to satisfy the check without faking any git metadata.
  mkdir -p .git
  go test ./... -short
  rm -rf .git
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 lazygit "$pkgdir/usr/bin/lazygit"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
