# Maintainer: Adam <adam@swamp-club.com>
pkgname=figlet
pkgver=2.2.5
pkgrel=1
pkgdesc="Program for making large letters out of ordinary text"
arch=(x86_64)
url="https://github.com/cmatsuoka/figlet"
license=(BSD-3-Clause)
depends=(glibc)
makedepends=()
checkdepends=()
options=()
source=("$pkgname-$pkgver.tar.gz::https://github.com/cmatsuoka/figlet/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('4d366c4a618ecdd6fdb81cde90edc54dbff9764efb635b3be47a929473f13930')

build() {
  cd "$pkgname-$pkgver"
  make \
    CFLAGS="$CFLAGS -Wall" \
    LDFLAGS="$LDFLAGS" \
    prefix=/usr \
    BINDIR=/usr/bin \
    MANDIR=/usr/share/man \
    DEFAULTFONTDIR=/usr/share/figlet \
    all
}

check() {
  cd "$pkgname-$pkgver"
  FIGLET_FONTDIR="$PWD/fonts" ./run-tests.sh "$PWD/fonts"
}

package() {
  cd "$pkgname-$pkgver"
  make \
    prefix=/usr \
    BINDIR=/usr/bin \
    MANDIR=/usr/share/man \
    DEFAULTFONTDIR=/usr/share/figlet \
    DESTDIR="$pkgdir" \
    install

  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 README CHANGES FAQ figfont.txt -t "$pkgdir/usr/share/doc/$pkgname/"
}
