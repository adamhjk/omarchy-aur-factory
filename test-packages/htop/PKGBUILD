# Maintainer: Adam <adam@swamp-club.com>
pkgname=htop
pkgver=3.5.3
pkgrel=1
pkgdesc="Interactive process viewer"
arch=(x86_64)
url="https://htop.dev/"
license=(GPL-2.0-only)
depends=(glibc ncurses libcap libnl lm_sensors)
makedepends=(autoconf automake)
checkdepends=()
optdepends=()
provides=()
conflicts=()
backup=()
options=()
install=
source=("$pkgname-$pkgver.tar.gz::https://github.com/htop-dev/htop/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('edf25ee020a5263ffbef9eef5a8c14392bf74e78b3d5c8bc64d9343dd9a82605')

prepare() {
  cd "$pkgname-$pkgver"
  autoreconf --force --install --verbose -Wall
}

build() {
  cd "$pkgname-$pkgver"
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --enable-unicode \
    --enable-affinity \
    --enable-capabilities \
    --enable-delayacct \
    --enable-sensors
  make
}

check() {
  cd "$pkgname-$pkgver"
  # htop ships no upstream test suite (no 'check'/'test' Makefile target).
  :
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}
